# Netlify Frontend Environment Variables
# Set this in your Netlify site settings to your Render backend URL (no trailing slash):
NEXT_PUBLIC_API_URL=https://spam-shield-api.onrender.com

# Render Backend Environment Variables
# Optional: Set this in Render if using a PostgreSQL database (e.g., Render Postgres / Supabase / Neon)
# Defaults to local SQLite if left empty.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: Restrict CORS to your Netlify site URL (default is *)
# ALLOWED_ORIGINS=https://your-site.netlify.app,http://localhost:3000

